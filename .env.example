# ---------------------------------------------------------------------------
# AI provider (Version 2 conversational layer).
# The app works WITHOUT these keys: the deterministic screening engine still
# runs and produces a full report. Only the chat/explanation layer is disabled.
# Configure ONE of the following.
# ---------------------------------------------------------------------------

# Option A - Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Option B - OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Force a provider ("anthropic" | "openai"). Leave blank to auto-detect
# from whichever key above is present.
AI_PROVIDER=

# ---------------------------------------------------------------------------
# GitHub CSV logging (data/query_log.csv).
# Server-side only. NEVER expose these to the browser.
# If unset, logging is skipped and the assessment still succeeds.
# ---------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_LOG_PATH=data/query_log.csv

# ---------------------------------------------------------------------------
# Site data providers
# ---------------------------------------------------------------------------
# Contact string sent as the User-Agent when calling public open-data APIs
# (Nominatim's usage policy asks for an identifiable User-Agent).
SITE_DATA_USER_AGENT=traces-site-suitability (set-your-contact@example.com)

# Set to "false" to disable all outbound site-data lookups (offline / demo mode).
ENABLE_REMOTE_SITE_DATA=true

# Timeout in milliseconds for each external site-data lookup.
SITE_DATA_TIMEOUT_MS=6000

# BGS geology service endpoint. Only set this if BGS moves the service; the
# provider's status message will tell you if it has.
BGS_MAPSERVER_URL=
