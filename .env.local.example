# Copy to .env.local (already gitignored) and fill in only the keys you have.
# No key set = that source is skipped, not treated as a failure - see
# scripts/probe-new-sources.mjs. Loaded via Node's built-in --env-file flag,
# no dependency added:
#
#   node --env-file=.env.local scripts/probe-new-sources.mjs
#   npm run dev    (Next.js loads .env.local automatically)

# Admiralty EasyTide API - tide state (spring/neap, flood/ebb) for estuaries.
# Get a key at https://developer.admiralty.co.uk/ (free tier available).
ADMIRALTY_TIDE_API_KEY=

# Copernicus Data Space Ecosystem - Sentinel-2 satellite turbidity (NDTI),
# lib/sources/satellite-turbidity.ts. Only fetched for a site that already
# has a nearby tide station (see that file's header for why).
# Register at https://dataspace.copernicus.eu/, create an OAuth2 client
# under your account to get these two values.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Identifies this app to public APIs that ask for a contact string in the
# User-Agent header (NRFA, BGS, Nominatim, EA). Not a secret - safe to set
# to anything identifying, e.g. "yourname@example.com".
SITE_DATA_USER_AGENT=
